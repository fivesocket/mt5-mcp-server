    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "mcp-remote": "0.16.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mt5",
    "mt5-mcp",
    "metatrader",
    "metatrader5",
    "metatrader-5",
    "mcp",
